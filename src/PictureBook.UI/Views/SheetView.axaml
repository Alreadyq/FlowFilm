<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PictureBook.UI.Views.SheetView">

  <UserControl.Styles>

    <Style Selector="TextBlock.panelhead">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,4,0,2" />
    </Style>

    <Style Selector="RadioButton.opt">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

  </UserControl.Styles>

  <Grid ColumnDefinitions="230,*,270">

    <!-- 左栏：画幅 -->
    <Border Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="14,14,14,14" Spacing="10">
        <TextBlock Classes="panelhead" Text="胶片画幅" />
        <ItemsControl ItemsSource="{Binding Formats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Classes="opt" GroupName="format" Content="{Binding}" IsChecked="False"
                           IsEnabled="False" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="画幅决定帧的毫米级几何：135 全幅 36×24mm、半格 18×24mm、XPan 36×65mm。排版模型已在 Core 就绪。"
                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 中央预览 -->
    <Panel Background="{StaticResource CanvasBrush}">
      <!-- 已收到流转帧：横向帧条预览 -->
      <StackPanel IsVisible="{Binding HasFrames}" Margin="24,20">
        <TextBlock Text="{Binding FramesSummary}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                   Margin="0,0,0,12" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Frames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="120" Height="90" CornerRadius="6" ClipToBounds="True"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="#33FFFFFF" BorderThickness="1"
                        AttachedToVisualTree="OnFrameAttached"
                        DetachedFromVisualTree="OnFrameDetached">
                  <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="帧排入画幅、齿孔与片边字渲染、A4 导出——渲染器下一阶段接入。"
                   FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />
      </StackPanel>

      <!-- 空态 -->
      <StackPanel IsVisible="{Binding !HasFrames}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Panel Width="150" Height="104" HorizontalAlignment="Center" Opacity="0.6">
          <Border BorderBrush="{StaticResource TextTertiaryBrush}" BorderThickness="2"
                  CornerRadius="6" Background="{StaticResource SurfaceBrush}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <Border Height="8" Background="#33FFFFFF" CornerRadius="2" />
            <Border Height="8" Background="#33FFFFFF" CornerRadius="2" />
            <Border Height="8" Background="#33FFFFFF" CornerRadius="2" />
            <Border Height="8" Background="#22FFFFFF" CornerRadius="2" Width="80" />
          </StackPanel>
        </Panel>
        <TextBlock Text="索引图预览" FontSize="19" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding PhotoSummary}" FontSize="12.5"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="扫描底片排成胶片索引图：齿孔、片边字、帧号、淡黄纸底，A4 比例导出。渲染器下一阶段接入。"
                   FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                   TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- 右栏：导出 -->
    <Border Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
      <StackPanel Margin="14,14,14,14" Spacing="10" IsEnabled="False" Opacity="0.6">
        <TextBlock Classes="panelhead" Text="纸张" />
        <ItemsControl ItemsSource="{Binding Papers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Classes="opt" GroupName="paper" Content="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="panelhead" Text="输出" Margin="0,10,0,0" />
        <CheckBox Content="显示齿孔" FontSize="12" />
        <CheckBox Content="显示片边型号字" FontSize="12" />
        <Button Content="导出 PNG（300 DPI）" Padding="12,7" CornerRadius="7"
                HorizontalAlignment="Left" Margin="0,8,0,0" />
        <TextBlock Text="导出依赖 SkiaSharp 渲染器，与排版模型一起在下一阶段接入。"
                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
