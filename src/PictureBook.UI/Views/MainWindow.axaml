<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PictureBook.UI.Views"
        x:Class="PictureBook.UI.Views.MainWindow"
        Title="PictureBook"
        Width="1280" Height="800" MinWidth="940" MinHeight="620"
        Background="{StaticResource CanvasBrush}">

  <Grid RowDefinitions="*,30">

    <Grid ColumnDefinitions="224,*">

      <!-- 侧栏 -->
      <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="0,10,0,10">
            <TextBlock Text="PictureBook" Margin="14,4,0,2" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="本地照片工作台" Margin="14,0,0,4" FontSize="11"
                       Foreground="{StaticResource TextTertiaryBrush}" />

            <TextBlock Classes="section" Text="功能" />
            <ListBox x:Name="NavList"
                     ItemsSource="{Binding Features}"
                     SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Button Classes="nav"
                              Classes.active="{Binding IsActive}"
                              Content="{Binding}" IsHitTestVisible="False" />
                    </ControlTemplate>
                  </Setter>
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="6,2">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" />
                    <TextBlock Classes="sub" Text="{Binding Subtitle}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 主内容：图库网格 / 功能说明 -->
      <Panel>
        <views:LibraryView IsVisible="{Binding IsLibrary}"
                           DataContext="{Binding Library}" />

        <ScrollViewer IsVisible="{Binding !IsLibrary}">
          <Panel Margin="36,30,36,30" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding SelectedTitle}" FontSize="26" FontWeight="SemiBold" />
              <Border Background="#3D4C8DFF" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedStatus}" FontSize="11.5"
                           Foreground="{StaticResource AccentBrush}" />
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding SelectedSubtitle}" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20,14" Margin="0,8,0,0">
              <StackPanel Spacing="10">
                <TextBlock Text="规划能力" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextTertiaryBrush}" />
                <ItemsControl ItemsSource="{Binding SelectedCapabilities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="该功能按规划逐步填充，图库已可用：导入 → 网格浏览 → 旗标筛选。"
                       FontSize="12.5" Foreground="{StaticResource TextTertiaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Panel>
        </ScrollViewer>
      </Panel>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="1" Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <TextBlock Text="{Binding SelectedTitle}" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBlock Text="PictureBook 0.2.0 · Avalonia / .NET 9 · 跨平台" FontSize="11"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
