<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PictureBook.UI.Views"
        x:Class="PictureBook.UI.Views.MainWindow"
        Title="PictureBook"
        Width="1280" Height="800" MinWidth="1040" MinHeight="640"
        Background="{StaticResource CanvasBrush}">

  <Window.Resources>
    <ControlTheme x:Key="TabTheme" TargetType="RadioButton">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="#3D4C8DFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- 顶栏：品牌 + 模块切换 -->
    <Border Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,9">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,20,0">
          <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Text="PictureBook" FontSize="14.5" FontWeight="Bold" />
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Theme="{StaticResource TabTheme}" GroupName="module"
                           Content="{Binding Title}"
                           IsChecked="{Binding IsActive, Mode=TwoWay}"
                           Checked="OnTabChecked" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="3" Text="0.2.0 · 本地照片工作台" FontSize="11"
                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 模块内容 -->
    <Panel Grid.Row="1">
      <views:LibraryView IsVisible="{Binding IsLibrary}" DataContext="{Binding Library}" />
      <views:FilmView IsVisible="{Binding IsFilm}" DataContext="{Binding Film}" />
      <views:SheetView IsVisible="{Binding IsSheet}" DataContext="{Binding Sheet}" />
    </Panel>
  </Grid>
</Window>
