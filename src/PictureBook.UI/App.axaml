<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PictureBook.UI.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="ChromeBrush" Color="#242529" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1B1C20" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2B31" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A4A4AC" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E78" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#1A1B1F" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="PingFang SC, Helvetica Neue, Segoe UI" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="14,16,0,6" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#334C8DFF" />
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav.active TextBlock.sub">
      <Setter Property="Foreground" Value="#CCE8F1FF" />
    </Style>
  </Application.Styles>
</Application>
